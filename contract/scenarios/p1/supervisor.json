  "chapter": "p1-supervisor",
  "description": "What the node's supervisor must do around a core (section 5.1 'Supervision'). Pending until a supervisor exists.",
  "scenarios": [
    {
      "id": "supervisor.starts_waits_for_locked_unlocks_and_waits_for_ready",
      "kind": "supervisor",
      "title": "Start, wait for locked, unlock, wait for ready",
      "status": "pending",
      "chapter": "p1-supervisor",
      "pending_reason": "No supervisor exists yet (P1 implementation). These are language-neutral data for the node's supervisor; the runner does not execute them.",
      "traces": [
        {
          "invariant": "I2",
          "section": "5.1"
        },
        {
          "invariant": "I2",
          "section": "5.2"
        }
      ],
      "config": {},
      "timeline": [
        {
          "core": "starts"
        },
        {
          "core": "answers_locked"
        },
        {
          "core": "answers_ready"
        }
      ],
      "expect": [
        {
          "node": "starts_core"
        },
        {
          "node": "polls_health",
          "until_state": "locked"
        },
        {
          "node": "unlocks"
        },
        {
          "node": "polls_health",
          "until_state": "ready"
        }
      ]
    },
    {
      "id": "supervisor.restarts_a_crashed_core_with_backoff",
      "kind": "supervisor",
      "title": "A core that exits is restarted, waiting longer each time",
      "status": "pending",
      "chapter": "p1-supervisor",
      "pending_reason": "No supervisor exists yet (P1 implementation). These are language-neutral data for the node's supervisor; the runner does not execute them.",
      "traces": [
        {
          "invariant": "I10",
          "section": "5.1"
        }
      ],
      "config": {
        "restart_limit": 5,
        "window_s": 60,
        "backoff_min_ms": 100,
        "backoff_max_ms": 30000
      },
      "timeline": [
        {
          "core": "starts"
        },
        {
          "core": "exits_crash",
          "times": 3
        }
      ],
      "expect": [
        {
          "node": "restarts_core",
          "attempts": 3,
          "delays_non_decreasing": true
        }
      ]
    },
