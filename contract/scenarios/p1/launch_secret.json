{
  "contract_version": "1.0-rc1",
  "kind": "scenario-file",
  "chapter": "p1-lifecycle",
  "description": "How the per-launch secret is handled (section 4 Authentication, I1): only a hook can see it.",
  "scenarios": [
    {
      "id": "launch_secret.is_not_on_the_command_line",
      "kind": "http",
      "title": "The secret does not appear in the core's argument list",
      "status": "active",
      "traces": [
        {
          "invariant": "I1",
          "section": "4"
        }
      ],
      "given": {
        "state": "locked"
      },
      "steps": [
        {
          "probe": {
            "name": "process_argv",
            "args": {
              "needle": "${secret}"
            },
            "expect": {
              "found": false
            }
          }
        }
      ],
      "requires": [
        "process_probe"
      ]
    },
    {
      "id": "launch_secret.file_is_private",
      "kind": "http",
      "title": "The file that carries the secret is readable by its owner only (0600)",
      "status": "active",
      "traces": [
        {
          "invariant": "I1",
          "section": "4"
        }
      ],
      "given": {
        "state": "locked"
      },
      "steps": [
        {
          "probe": {
            "name": "runtime_file_mode",
            "args": {},
            "expect": {
              "mode": "0600"
            }
          }
        }
      ],
      "requires": [
        "runtime_file_probe"
      ]
    },
    {
      "id": "launch_secret.differs_between_launches",
      "kind": "http",
      "title": "Two launches of the core receive two different secrets",
      "status": "active",
      "traces": [
        {
          "invariant": "I1",
          "section": "4"
        }
      ],
      "given": {
        "state": "locked"
      },
      "steps": [
        {
          "probe": {
            "name": "launch_twice_secrets",
            "args": {},
            "expect": {
              "distinct": true
            }
          }
        }
      ],
      "requires": [
        "launch_probe",
        "restart"
      ]
    },
    {
      "id": "launch_secret.core_listens_on_loopback_only",
      "kind": "http",
      "title": "Every listening socket of the core is on a loopback address",
      "status": "active",
      "traces": [
        {
          "invariant": "I1",
          "section": "3"
        },
        {
          "invariant": "I1",
          "section": "4"
        }
      ],
      "given": {
        "state": "locked"
      },
      "steps": [
        {
          "probe": {
            "name": "listen_addresses",
            "args": {},
            "expect": {
              "all_loopback": true
            }
          }
        }
      ],
      "requires": [
        "socket_probe"
      ]
    }
  ]
}
