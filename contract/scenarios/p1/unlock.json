          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.wrong}",
              "context": "${context}",
              "extensions": {
                "force": true,
                "skip_check": true,
                "trusted": true,
                "key": "${key.valid}"
              }
            }
          },
          "expect": {
            "status": 403,
            "error_code": "forbidden",
            "must_not_contain": [
