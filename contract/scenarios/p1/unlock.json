{
  "contract_version": "1.0-rc1",
  "kind": "scenario-file",
  "chapter": "p1-lifecycle",
  "description": "POST /v1/unlock (section 5.2, appendix D): what unlocks, what never does.",
  "scenarios": [
    {
      "id": "unlock.valid_key_makes_the_core_ready",
      "kind": "http",
      "title": "A valid derived key and the right context: 200 ready, health says ready, capabilities become readable",
      "status": "active",
      "traces": [
        {
          "invariant": "I2",
          "section": "5.2"
        }
      ],
      "given": {
        "state": "locked"
      },
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.valid}",
              "context": "${context}"
            }
          },
          "expect": {
            "status": 200,
            "body_schema": "lifecycle/unlock.response",
            "body_pointer": {
              "/state": "ready"
            },
            "must_not_contain": [
              "${key.valid}",
              "${secret}"
            ]
          }
        },
        {
          "assert_health": "ready"
        },
        {
          "request": {
            "method": "GET",
            "path": "/v1/capabilities"
          },
          "expect": {
            "status": 200,
            "body_schema": "lifecycle/capabilities",
            "must_not_contain": [
              "${key.valid}",
              "${secret}"
            ]
          }
        }
      ]
    },
    {
      "id": "unlock.wrong_key_never_becomes_ready",
      "kind": "http",
      "title": "A well-formed but wrong key is 403 forbidden; the core stays locked, holds no decrypted state, and later unlocks normally",
      "status": "active",
      "traces": [
        {
          "invariant": "I2",
          "section": "5.2"
        },
        {
          "invariant": "I2",
          "section": "D",
          "clause": "D.3"
        }
      ],
      "given": {
        "state": "locked"
      },
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.wrong}",
              "context": "${context}"
            }
          },
          "expect": {
            "status": 403,
            "error_code": "forbidden",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "assert_health": "locked"
        },
        {
          "request": {
            "method": "GET",
            "path": "/v1/capabilities"
          },
          "expect": {
            "status": 423,
            "error_code": "locked",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/lock",
            "body": {}
          },
          "expect": {
            "status": 423,
            "error_code": "locked",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {}
          },
          "expect": {
            "status": 423,
            "error_code": "locked",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}"
            ]
          }
        },
        {
          "assert_health": "locked"
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.valid}",
              "context": "${context}"
            }
          },
          "expect": {
            "status": 200,
            "body_schema": "lifecycle/unlock.response",
            "body_pointer": {
              "/state": "ready"
            },
            "must_not_contain": [
              "${key.valid}",
              "${secret}"
            ]
          }
        },
        {
          "assert_health": "ready"
        }
      ]
    },
