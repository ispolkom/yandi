    {
      "id": "unlock.extensions_cannot_change_what_is_allowed",
      "kind": "http",
      "title": "A wrong key with extensions that ask for a bypass is still 403 and stays locked",
      "status": "active",
      "traces": [
        {
          "invariant": "I9",
          "section": "4"
        },
        {
          "invariant": "I2",
          "section": "5.2"
        }
      ],
      "given": {
        "state": "locked"
