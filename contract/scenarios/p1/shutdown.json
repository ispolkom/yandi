{
  "contract_version": "1.0-rc1",
  "kind": "scenario-file",
  "chapter": "p1-lifecycle",
  "description": "POST /v1/shutdown (section 5.1): ready → draining → stopped.",
  "scenarios": [
    {
      "id": "shutdown.invalid_requests_are_refused_and_change_nothing",
      "kind": "http",
      "title": "Unknown field, bad deadline, no key, non-object body: 400 and the core stays ready",
      "status": "active",
      "traces": [
        {
          "invariant": "I10",
          "section": "D",
          "clause": "D.2"
        },
        {
          "invariant": "I9",
          "section": "4"
        }
      ],
      "given": {
        "state": "ready"
      },
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {
              "now": true
            }
          },
          "expect": {
            "status": 400,
            "error_code": "invalid_payload",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {
              "deadline_ms": 0
            }
          },
          "expect": {
            "status": 400,
            "error_code": "invalid_payload",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {
              "deadline_ms": -5
            }
          },
          "expect": {
            "status": 400,
            "error_code": "invalid_payload",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {
              "deadline_ms": "5000"
            }
          },
          "expect": {
            "status": 400,
            "error_code": "invalid_payload",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {
              "deadline_ms": 1.5
            }
          },
          "expect": {
            "status": 400,
            "error_code": "invalid_payload",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {
              "deadline_ms": null
            }
          },
          "expect": {
            "status": 400,
            "error_code": "invalid_payload",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {
              "deadline_ms": true
            }
          },
          "expect": {
            "status": 400,
            "error_code": "invalid_payload",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {},
            "idempotency_key": "none"
          },
          "expect": {
            "status": 400,
            "error_code": "invalid_payload",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body_raw": "[]"
          },
          "expect": {
            "status": 400,
            "error_code": "invalid_payload",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "assert_health": "ready"
        }
      ]
    },
    {
      "id": "shutdown.goes_through_draining_to_stopped",
      "kind": "http",
      "title": "202 draining, then health shows draining or nothing answers any more, and finally nothing answers",
      "status": "active",
      "traces": [
        {
          "invariant": "I10",
          "section": "5.1"
        },
        {
          "invariant": "I6",
          "section": "5.1"
        }
      ],
      "given": {
        "state": "ready"
      },
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {
              "deadline_ms": 5000
            }
          },
          "expect": {
            "status": 202,
            "body_schema": "lifecycle/shutdown.response",
            "body_pointer": {
              "/state": "draining"
            }
          }
        },
        {
          "wait_stopped": {
            "timeout_ms": 15000,
            "allowed_health_states": [
              "draining"
            ]
          }
        }
      ],
      "requires": [
        "restart"
      ],
      "destructive": true
    },
    {
      "id": "shutdown.deadline_is_optional",
      "kind": "http",
      "title": "An empty request also starts the graceful stop",
      "status": "active",
      "traces": [
        {
          "invariant": "I10",
          "section": "D",
          "clause": "D.2"
        }
      ],
      "given": {
        "state": "ready"
      },
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {}
          },
          "expect": {
            "status": 202,
            "body_schema": "lifecycle/shutdown.response",
            "body_pointer": {
              "/state": "draining"
            }
          }
        },
        {
          "wait_stopped": {
            "timeout_ms": 15000,
            "allowed_health_states": [
              "draining"
            ]
          }
        }
      ],
      "requires": [
        "restart"
      ],
      "destructive": true
    },
    {
      "id": "shutdown.replay_while_draining_is_answered_from_the_record",
      "kind": "http",
      "title": "While draining, the same key and body gets the original 202; the same key with another deadline is 409",
      "status": "active",
      "traces": [
        {
          "invariant": "I6",
          "section": "D",
          "clause": "D.4"
        },
        {
          "invariant": "I6",
          "section": "D",
          "clause": "D.5"
        }
      ],
      "given": {
        "state": "ready"
      },
      "steps": [
        {
          "id": "first",
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {
              "deadline_ms": 5000
            },
            "idempotency_key": "shut-a-${run}"
          },
          "expect": {
            "status": 202,
            "body_schema": "lifecycle/shutdown.response",
            "body_pointer": {
              "/state": "draining"
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {
              "deadline_ms": 5000
            },
            "idempotency_key": "shut-a-${run}"
          },
          "expect": {
            "status": 202,
            "body_schema": "lifecycle/shutdown.response",
            "body_pointer": {
              "/state": "draining"
            },
            "same_body_as": "first"
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {
              "deadline_ms": 7000
            },
            "idempotency_key": "shut-a-${run}"
          },
          "expect": {
            "status": 409,
            "error_code": "idempotency_conflict",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "probe": {
            "name": "release_drain"
          }
        },
        {
          "wait_stopped": {
            "timeout_ms": 15000,
            "allowed_health_states": [
              "draining"
            ]
          }
        }
      ],
      "requires": [
        "restart",
        "drain_hold"
      ],
      "destructive": true
    },
    {
      "id": "shutdown.open_transaction_completes_or_rolls_back",
      "kind": "http",
      "status": "pending",
      "pending_reason": "Needs a way to hold a transaction open inside the core (hook 'transaction_probe'). Section 5.1 promises finish-or-roll-back; no black-box request can prove it, so no guarantee is claimed yet.",
      "title": "A transaction open at shutdown is finished or rolled back, never left half-done",
      "traces": [
        {
          "invariant": "I6",
          "section": "5.1"
        }
      ],
      "given": {
        "state": "ready"
      },
      "requires": [
        "restart",
        "transaction_probe"
      ],
      "destructive": true,
      "steps": [
        {
          "probe": {
            "name": "open_transaction",
            "args": {},
            "expect": {
              "opened": true
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/shutdown",
            "body": {
              "deadline_ms": 5000
            }
          },
          "expect": {
            "status": 202,
            "body_schema": "lifecycle/shutdown.response",
            "body_pointer": {
              "/state": "draining"
            }
          }
        },
        {
          "wait_stopped": {
            "timeout_ms": 15000,
            "allowed_health_states": [
              "draining"
            ]
          }
        },
        {
          "probe": {
            "name": "open_transaction",
            "args": {
              "check": "after_stop"
            },
            "expect": {
              "half_done": false
            }
          }
        }
      ]
    }
  ]
}
