          "request": {
            "method": "POST",
            "path": "/v1/lock",
            "body": {},
            "idempotency_key": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
