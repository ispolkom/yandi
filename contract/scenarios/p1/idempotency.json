        {
          "request": {
            "method": "POST",
            "path": "/v1/lock",
            "body": {},
            "idempotency_key": "idem-a-${run}"
          },
          "expect": {
            "status": 200,
            "body_schema": "lifecycle/lock.response",
            "body_pointer": {
              "/state": "locked"
            },
            "must_not_contain": [
              "${key.valid}",
              "${secret}"
            ]
          }
        },
        {
          "assert_health": "ready"
        }
      ]
    },
    {
      "id": "idempotency.a_new_key_is_a_new_request",
      "kind": "http",
      "title": "The key identifies the request: the same words under another key are a new event (here refused by the state)",
      "status": "active",
      "traces": [
        {
          "invariant": "I6",
          "section": "1"
        },
        {
          "invariant": "I6",
          "section": "4"
        }
      ],
      "given": {
        "state": "ready"
      },
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/lock",
            "body": {},
            "idempotency_key": "idem-1-${run}"
          },
          "expect": {
            "status": 200,
            "body_schema": "lifecycle/lock.response",
            "body_pointer": {
              "/state": "locked"
            },
            "must_not_contain": [
              "${key.valid}",
              "${secret}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/lock",
            "body": {},
            "idempotency_key": "idem-2-${run}"
          },
          "expect": {
            "status": 423,
            "error_code": "locked",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}"
            ]
          }
        },
        {
          "assert_health": "locked"
        }
      ]
    },
    {
      "id": "idempotency.key_is_required_on_a_locked_core_mutation",
      "kind": "http",
      "title": "unlock without Idempotency-Key is 400 and does not unlock",
      "status": "active",
      "traces": [
        {
          "invariant": "I6",
          "section": "4"
        },
        {
          "invariant": "I10",
          "section": "D",
          "clause": "D.3"
        }
      ],
      "given": {
        "state": "locked"
      },
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.valid}",
              "context": "${context}"
            },
            "idempotency_key": "none"
          },
          "expect": {
            "status": 400,
            "error_code": "invalid_payload",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
