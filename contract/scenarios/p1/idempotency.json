      "traces": [
        {
          "invariant": "I6",
          "section": "1"
        },
        {
          "invariant": "I6",
          "section": "D",
          "clause": "D.5"
        }
      ],
      "given": {
        "state": "ready"
      },
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/lock",
            "body": {},
            "idempotency_key": "idem-a-${run}"
          },
          "expect": {
            "status": 200,
            "body_schema": "lifecycle/lock.response",
            "body_pointer": {
              "/state": "locked"
            },
            "must_not_contain": [
              "${key.valid}",
              "${secret}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.valid}",
              "context": "${context}"
