{
  "contract_version": "1.0-rc1",
  "kind": "scenario-file",
  "chapter": "p1-lifecycle",
  "description": "Idempotency on lifecycle mutations (I6, section 4, appendix D.4-D.5).",
  "scenarios": [
    {
      "id": "idempotency.unlock_same_key_same_body_gives_the_same_answer",
      "kind": "http",
      "title": "A retried unlock is answered from the record: same 200, no second effect",
      "status": "active",
      "traces": [
        {
          "invariant": "I6",
          "section": "4"
        },
        {
          "invariant": "I6",
          "section": "D",
          "clause": "D.5"
        }
      ],
      "given": {
        "state": "locked"
      },
      "steps": [
        {
          "id": "first",
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.valid}",
              "context": "${context}"
            },
            "idempotency_key": "idem-a-${run}"
          },
          "expect": {
            "status": 200,
            "body_schema": "lifecycle/unlock.response",
            "body_pointer": {
              "/state": "ready"
            },
            "must_not_contain": [
              "${key.valid}",
              "${secret}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.valid}",
              "context": "${context}"
            },
            "idempotency_key": "idem-a-${run}"
          },
          "expect": {
            "status": 200,
            "body_schema": "lifecycle/unlock.response",
            "body_pointer": {
              "/state": "ready"
            },
            "must_not_contain": [
              "${key.valid}",
              "${secret}"
            ],
            "same_body_as": "first"
          }
        },
        {
          "assert_health": "ready"
        }
      ]
    },
    {
      "id": "idempotency.unlock_delivered_eight_times_at_once",
      "kind": "http",
      "title": "Eight simultaneous copies of one unlock all get the same 200",
      "status": "active",
      "traces": [
        {
          "invariant": "I6",
          "section": "4"
        },
        {
          "invariant": "I6",
          "section": "D",
          "clause": "D.5"
        }
      ],
      "given": {
        "state": "locked"
      },
      "steps": [
        {
          "parallel": {
            "count": 8,
            "request": {
              "method": "POST",
              "path": "/v1/unlock",
              "body": {
                "key": "${key.valid}",
                "context": "${context}"
              },
              "idempotency_key": "idem-a-${run}"
            },
            "expect_all": {
              "status": 200,
              "body_schema": "lifecycle/unlock.response",
              "body_pointer": {
                "/state": "ready"
              },
              "must_not_contain": [
                "${key.valid}",
                "${secret}"
              ]
            },
            "identical_bodies": true
          }
        },
        {
          "assert_health": "ready"
        }
      ]
    },
    {
      "id": "idempotency.unlock_same_key_different_body_conflicts",
      "kind": "http",
      "title": "The same key with another body is 409; the state is not touched",
      "status": "active",
      "traces": [
        {
          "invariant": "I6",
          "section": "4"
        },
        {
          "invariant": "I6",
          "section": "D",
          "clause": "D.5"
        }
      ],
      "given": {
        "state": "locked"
      },
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.valid}",
              "context": "${context}"
            },
            "idempotency_key": "idem-a-${run}"
          },
          "expect": {
            "status": 200,
            "body_schema": "lifecycle/unlock.response",
            "body_pointer": {
              "/state": "ready"
            },
            "must_not_contain": [
              "${key.valid}",
              "${secret}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.valid}",
              "context": "${context}",
              "extensions": {
                "n": 1
              }
            },
            "idempotency_key": "idem-a-${run}"
          },
          "expect": {
            "status": 409,
            "error_code": "idempotency_conflict",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.wrong}",
              "context": "${context}"
            },
            "idempotency_key": "idem-a-${run}"
          },
          "expect": {
            "status": 409,
            "error_code": "idempotency_conflict",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}",
              "${key.wrong}"
            ]
          }
        },
        {
          "assert_health": "ready"
        }
      ]
    },
