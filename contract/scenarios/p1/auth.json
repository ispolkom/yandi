    {
      "id": "auth.correct_secret_is_allowed",
      "kind": "http",
      "title": "The correct secret is accepted on a ready core",
      "status": "active",
      "traces": [
        {
          "invariant": "I1",
          "section": "4"
        }
      ],
      "given": {
        "state": "ready"
      },
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/v1/capabilities"
          },
          "expect": {
            "status": 200,
            "body_schema": "lifecycle/capabilities",
            "must_not_contain": [
              "${key.valid}",
              "${secret}"
            ]
          }
        }
      ]
    },
    {
      "id": "auth.refusal_comes_before_every_other_check",
      "kind": "http",
      "title": "Without a secret, a malformed body, a missing idempotency key, an oversized body and an unknown path are all 401",
      "status": "active",
      "traces": [
        {
          "invariant": "I10",
          "section": "D",
          "clause": "D.4"
        },
        {
          "invariant": "I1",
          "section": "4"
        }
      ],
      "given": {
        "state": "locked"
      },
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body_raw": "{not json",
            "auth": "none"
          },
          "expect": {
            "status": 401,
            "error_code": "unauthorized",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.valid}",
              "context": "${context}"
            },
            "auth": "none",
            "idempotency_key": "none"
          },
          "expect": {
            "status": 401,
            "error_code": "unauthorized",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}"
            ]
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.valid}",
              "context": "${context}"
            },
            "auth": "none",
            "body_pad_to": 70000
          },
          "expect": {
            "status": 401,
            "error_code": "unauthorized",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}"
            ]
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/v1/no-such-endpoint",
            "auth": "none"
          },
          "expect": {
            "status": 401,
            "error_code": "unauthorized",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}"
            ]
          }
        },
        {
          "assert_health": "locked"
        }
      ]
    },
    {
      "id": "auth.principal_and_actor_headers_grant_nothing",
      "kind": "http",
      "title": "X-Principal and X-Actor are not credentials: with them and no secret the answer is still 401",
      "status": "active",
      "traces": [
        {
          "invariant": "I1",
          "section": "D",
          "clause": "D.6"
        },
        {
          "invariant": "I11",
          "section": "D",
          "clause": "D.6"
        }
      ],
      "given": {
        "state": "locked"
      },
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/unlock",
            "body": {
              "key": "${key.valid}",
              "context": "${context}"
            },
            "auth": "none",
            "headers": {
              "X-Principal": "person_01HZXK3M9Q",
              "X-Actor": "device-abc12345"
            }
          },
          "expect": {
            "status": 401,
            "error_code": "unauthorized",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}"
            ]
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/v1/capabilities",
            "auth": "none",
            "headers": {
              "X-Principal": "person_01HZXK3M9Q"
            }
          },
          "expect": {
            "status": 401,
            "error_code": "unauthorized",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}"
            ]
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/v1/capabilities",
            "auth": "none",
            "headers": {
              "X-Actor": "device-abc12345"
            }
          },
          "expect": {
            "status": 401,
            "error_code": "unauthorized",
            "must_not_contain": [
              "@leaks",
              "${secret}",
              "${key.valid}"
            ]
          }
        },
        {
          "assert_health": "locked"
        }
      ]
