{
  "contract_version": "1.0-rc1",
  "kind": "leak-patterns",
  "description": "Regular expressions (Python/ECMAScript-compatible subset) that an error body or a health body must never match (I8, appendix D.7). '@leaks' in a fixture means every group; '@leaks:paths' means one group. Literals such as ${secret} are separate and always exact.",
  "groups": {
    "paths": [
      "(?<![A-Za-z0-9_.-])/(?:home|tmp|var|usr|etc|run|opt|root|proc|srv|mnt|media|Users|dev|sys)/",
      "[A-Za-z]:\\\\{1,2}[A-Za-z0-9_.-]",
      "\\\\\\\\[A-Za-z0-9_.-]+\\\\[A-Za-z0-9_.$-]+"
    ],
    "sockets": [
      "\\.sock\\b",
      "unix://",
      "\\.pid\\b"
    ],
    "addresses": [
      "\\b[0-9]{1,3}(?:\\.[0-9]{1,3}){3}(?::[0-9]{1,5})?\\b",
      "(?i)\\blocalhost\\b",
      "\\[::1\\]",
      "(?i)\\b(?:[0-9a-f]{1,4}:){3,7}[0-9a-f]{1,4}\\b"
    ],
    "backends": [
      "(?i)\\b(?:mysql|mariadb|pymysql|sqlalchemy|sqlite|postgres|psycopg|redis|llama\\.cpp|ollama|uvicorn|fastapi|starlette|hyper|tokio|axum)\\b",
      "(?i)\\berrno\\b",
      "(?i)\\bconnection (?:refused|reset)\\b",
      "(?i)\\bcheck value\\b"
    ],
    "traces": [
      "Traceback \\(most recent call last\\)",
      "File \"[^\"]+\", line [0-9]+",
      "(?i)\\bpanicked at\\b",
      "\\.(?:py|rs|so|dll)\\b",
      "(?i)\\b(?:RecursionError|KeyError|ValueError|TypeError|AttributeError|UnicodeDecodeError|JSONDecodeError|IndexError|OSError)\\b"
    ],
    "env": [
      "\\bYANDI_[A-Z0-9_]+\\b",
      "\\b[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+\\b",
      "\\b(?:HOME|PATH|USER|TMPDIR|XDG_[A-Z_]+|LD_[A-Z_]+|PYTHON[A-Z_]*)\\b"
    ],
    "credentials": [
      "(?i)\\bapi[_ -]?keys?\\b",
      "(?i)\\bpass(?:word|phrase)s?\\b",
      "(?i)\\bcredentials?\\b",
      "(?i)\\bprivate[_ -]?keys?\\b",
      "(?i)\\bmaster[_ -]?keys?\\b",
      "(?i)\\bvault\\b"
    ]
  }
}
